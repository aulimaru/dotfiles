{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "ext/workspaces",
    "custom/countdown"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "clock",
    "network",
    "pulseaudio",
    "backlight",
    "temperature",
    "cpu",
    "memory",
    "battery",
    "tray"
  ],
  "hyprland/window": {
    "max-length": 200,
    "separate-outputs": true
  },
  "battery": {
    "interval": 3,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },
  "clock": {
    "interval": 1,
    "format": "󰃰 {:%T}",
    "format-alt": " {:%Y-%m-%d}",
    "tooltip-format": "<big>{:%e %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "format-alt": " {usage}% {load}",
    "states": {
      "high": 50,
      "warning": 70,
      "critical": 90
    }
  },
  "memory": {
    "interval": 5,
    "format": " {}%",
    "format-alt": "︁ {used:0.1f}/{total:0.1f}GB",
    "states": {
      "high": 50,
      "warning": 70,
      "critical": 90
    }
  },
  "network": {
    "interval": 3,
    "format-wifi": "",
    "format-ethernet": "{cidr}",
    "format-disconnected": "󰖪",
    "tooltip-format": "{essid} ({signalStrength}%) {ifname}: {ipaddr}"
  },
  "ext/workspaces": {
    "all-outputs": false,
    "sort-by-name": false,
    "sort-by-id": false,
    "sort-by-coordinates": true,
    "ignore-hidden": true,
    "on-click": "activate",
    "format": "{icon}{name}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    }
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "{volume}% {icon}  {format_source} ",
    "format-bluetooth": "{volume}% {icon}  {format_source}",
    "format-bluetooth-muted": " {icon}  {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "interval": 5,
    "critical-threshold": 75,
    "format": "{icon}  {temperatureC}°C",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": {
      "default": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "dynamic-order": [
      "title",
      "artist"
    ]
  },
  "custom/countdown": {
    "interval": 2,
    "format": "{text}",
    "tooltip": "true",
    "return-type": "json",
    "exec": " ~/scripts/countdown.sh",
    "exec-if": "which countdown"
  }
}
